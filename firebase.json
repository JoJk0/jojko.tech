{
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": ".output/server"
  },
  "hosting": [
    {
      "site": "jjk-nuxt-example",
      "public": ".output/public",
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "**",
          "function": "server"
        }
      ],
      "redirects": [
        {
          "source": "/.well-known/host-meta",
          "destination": "https://101010.pl/.well-known/host-meta?resource=acct:jojko@101010.pl",
          "type": 301
        },
        {
          "source": "/.well-known/webfinger",
          "destination": "https://101010.pl/.well-known/webfinger?resource=acct:jojko@101010.pl",
          "type": 301
        },
        {
          "source": "/mastodon",
          "destination": "https://101010.pl/@jojko",
          "type": 302
        }
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 2139
    },
    "database": {
      "port": 2141
    },
    "hosting": {
      "port": 2138
    },
    "storage": {
      "port": 2140
    },
    "ui": {
      "enabled": true
    }
  }
}
