{
  "packageManager": "pnpm@10.4.1",
  "type": "module",
  "scripts": {
    "build": "nuxi build",
    "dev": "nuxi dev",
    "dev:pwa": "VITE_PLUGIN_PWA=true nuxi dev",
    "start": "node .output/server/index.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "up": "taze major -I",
    "postinstall": "nuxi prepare",
    "generate": "nuxi generate",
    "functions:deploy": "cd ./functions && firebase deploy --only functions",
    "start:generate": "npx serve .output/public",
    "functions:dev": "cd ./functions && npm run build && firebase emulators:start --only functions"
  },
  "dependencies": {
    "altcha": "^1.2.0",
    "jjk-ui": "^1.2.1"
  },
  "devDependencies": {
    "@codersrank/portfolio": "^0.9.10",
    "@iconify-json/carbon": "^1.2.6",
    "@iconify-json/feather": "^1.2.1",
    "@iconify-json/line-md": "^1.2.5",
    "@iconify-json/logos": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.14",
    "@iconify-json/twemoji": "^1.2.2",
    "@nuxt/devtools": "^1.7.0",
    "@nuxt/eslint": "^1.0.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/i18n": "9.1.5",
    "@pinia/nuxt": "^0.9.0",
    "@sxzz/eslint-config": "^5.1.1",
    "@vite-pwa/nuxt": "^0.10.6",
    "@vueuse/nuxt": "^12.5.0",
    "consola": "^3.4.0",
    "eslint": "^9.19.0",
    "eslint-plugin-format": "^1.0.1",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.1",
    "firebase-functions-test": "^3.4.0",
    "firebase-tools": "^13.29.3",
    "nuxt": "^3.15.4",
    "pinia": "^2.3.1",
    "taze": "^18.3.0",
    "typescript": "^5.8.2",
    "unplugin-icons": "^22.0.0",
    "vue-tsc": "^2.2.0"
  },
  "resolutions": {
    "@nuxt/devtools": "2.0.0-beta.2",
    "unplugin": "^2.1.2",
    "vite": "^6.0.7"
  },
  "pnpm": {
    "overrides": {
      "jjk-ui": "link:../jjk-ui"
    }
  }
}
